#!/usr/bin/env bash
# Promote a draft from _drafts/ to _posts/, dating it.
#
#   scripts/publish usb-uart-comparison               # publish today
#   scripts/publish usb-uart-comparison 2026-08-10    # schedule for a future date
#
# A future-dated post sits in _posts/ on main and is invisible to every build
# until its date arrives. The daily GitHub Actions cron rebuilds the site and it
# appears on its own. That is the whole scheduling mechanism.
#
# All indexes -- archive, tags, categories, hardware, search.json, feed, sitemap
# -- are regenerated by Jekyll from the posts collection at build time. Nothing
# is updated by hand here.
set -euo pipefail

cd "$(dirname "$0")/.."

# Time of day for published posts. The publish cron runs at 00:20 America/Los_Angeles;
# dating a post slightly BEFORE that means it is already in the past when the build
# runs and so gets included. A later time would silently slip a day.
POST_TIME="00:15:00"

if [[ $# -lt 1 ]]; then
  echo "usage: scripts/publish <draft-slug> [YYYY-MM-DD]" >&2
  echo "       scripts/publish --list" >&2
  exit 1
fi

if [[ "$1" == "--list" ]]; then
  echo "drafts:"
  ls -1 _drafts/*.md 2>/dev/null | sed 's|_drafts/||; s|\.md$||; s|^|  |' || echo "  (none)"
  exit 0
fi

slug="${1%.md}"
slug="${slug#_drafts/}"
date_arg="${2:-$(date +%Y-%m-%d)}"

src="_drafts/${slug}.md"
[[ -f "$src" ]] || { echo "error: $src not found (try scripts/publish --list)" >&2; exit 1; }

if ! [[ "$date_arg" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "error: date must be YYYY-MM-DD, got '$date_arg'" >&2
  exit 1
fi

if [[ "$date_arg" < "$(date +%Y-%m-%d)" ]]; then
  echo "error: $date_arg is in the past; a back-dated post buries itself in the archive" >&2
  exit 1
fi

dest="_posts/${date_arg}-${slug}.md"
[[ -e "$dest" ]] && { echo "error: $dest already exists" >&2; exit 1; }

# Offset is -0700 during PDT, -0800 during PST. Ask the system rather than guess.
tz_offset=$(date +%z)

# Set or insert the date line inside the front matter block.
tmp=$(mktemp)
awk -v newdate="date: ${date_arg} ${POST_TIME} ${tz_offset}" '
  BEGIN { fm = 0; seen_date = 0 }
  NR == 1 && $0 == "---" { fm = 1; print; next }
  fm == 1 && /^---[[:space:]]*$/ {
    if (!seen_date) print newdate
    fm = 2; print; next
  }
  fm == 1 && /^date:/ { print newdate; seen_date = 1; next }
  { print }
' "$src" > "$tmp"

mkdir -p _posts
mv "$tmp" "$dest"
rm -f "$src"

if git ls-files --error-unmatch "$src" >/dev/null 2>&1; then
  git rm --cached --quiet "$src"
fi
git add "$dest"

echo "staged $dest"

if [[ -x scripts/validate ]]; then
  scripts/validate || { echo "error: validation failed; post staged but not committed" >&2; exit 1; }
fi

if [[ "$date_arg" == "$(date +%Y-%m-%d)" ]]; then
  msg="Publish: ${slug}"
else
  msg="Schedule: ${slug} (publish ${date_arg})"
fi

git commit -q -m "$msg"
git push -q origin main

echo "$msg"
if [[ "$date_arg" == "$(date +%Y-%m-%d)" ]]; then
  echo "deploying now -- watch: gh run watch"
else
  echo "will go live on ${date_arg} via the daily publish cron"
fi
